# Copy to .env and fill in real values before running.

# Postgres connection string. See PRODUCTION_READINESS.md for the note on
# running `prisma migrate dev` yourself once you're off this sandbox.
DATABASE_URL="postgresql://user:password@localhost:5432/chambers_dev?schema=public"

# Signs session JWTs. Generate a real random value, e.g.:
#   openssl rand -base64 32
# Rotating this invalidates every existing session.
AUTH_SECRET="change-me-to-a-random-32+-byte-string"

# Encrypts firm-level AI provider API keys at rest (AES-256-GCM). In
# production this should come from a KMS-managed secret, not a raw env var
# — see src/lib/server-crypto.ts.
AI_ENCRYPTION_KEY="change-me-to-a-random-32-byte-string"

# --- Only needed for docker-compose.yml (VPS deployment) ---------------
# These build the DATABASE_URL above automatically inside the compose file;
# you don't need them for local `npm run dev` if you set DATABASE_URL
# directly. See DEPLOYMENT.md.
POSTGRES_USER="chambers"
POSTGRES_PASSWORD="change-me-to-a-long-random-password"
POSTGRES_DB="chambers_prod"
